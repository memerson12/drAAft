{
  "schemaVersion": 1,
  "id": "draaft",
  "version": "${version}",
  "name": "drAAft",
  "description": "Mod for Pac's awesome AA Event",
  "authors": [
    "DesktopFolder",
    "me_nx",
    "Memerson",
    "PacManMVC"
  ],
  "contact": {
    "homepage": "https://disrespec.tech/draaft/",
    "sources": "https://github.com/memerson12/drAAft"
  },
  "license": "CC0-1.0",
  "icon": "assets/draaft/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "draaft.draaft"
    ],
    "speedrunigt": [
      "draaft.compat.speedrunigt.Entrypoint"
    ]
  },
  "mixins": [
    "draaft.mixins.json"
  ],
  "accessWidener": "draaft.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.16.1",
    "java": ">=16",
    "speedrunapi": ">=2.0+1.16.1"
  },
  "breaks": {
    "mcsrfairplay": "*",
    "seedqueue": "*",
    "speedrunigt": "<7.0"
  },
  "custom": {
    "speedrunapi": {
      "config": "draaft.client.ModConfig"
    }
  }
}
